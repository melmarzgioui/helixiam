<?xml version="1.0" encoding="UTF-8"?>
<!--
  Helix IAM E8.5-S4 (Events): logging config that preserves Spring Boot's normal console output for app
  logs and adds a dedicated "helix.audit" logger whose lines are PURE JSON (one audit event per line,
  undecorated) so a SIEM can scrape them straight from stdout. The root appender reuses Boot's own
  CONSOLE_LOG_PATTERN (set by Boot before logging init), so existing app log formatting is unchanged.

  SIEM delivery: stdout JSON (here) is always on. Active HTTP push is handled in code
  (HttpAuditForwarder, configured via helix.audit.http.*). The commented Syslog/HTTP appenders below are
  alternative log-pipeline transports an operator can enable without code changes.
-->
<Configuration status="WARN">
    <!--
      Log-injection defence (CodeQL java/log-injection): the log MESSAGE is always rendered through
      %enc{%m}{CRLF}, which escapes CR/LF to the literal two characters "\r" / "\n", so a user-controlled
      value (username, client id, realm id, request parameter) can never start a forged log line. Stack traces
      (%xwEx / %throwable) are outside %m and keep their normal multi-line layout. Call sites additionally pass
      user-controlled arguments through io.helixiam.common.log.LogSafe.

      CONSOLE_LOG_PATTERN below is the default; Boot's ${sys:CONSOLE_LOG_PATTERN} (set from
      logging.pattern.console) overrides it. An operator overriding that property should keep %enc{%m}{CRLF}.
    -->
    <Properties>
        <Property name="CONSOLE_LOG_PATTERN">%d %-5level %logger - %enc{%m}{CRLF}%n</Property>
    </Properties>
    <Appenders>
        <!-- Application logs: Boot's standard console format (falls back to a plain pattern off-Boot). -->
        <Console name="Console" target="SYSTEM_OUT">
            <!-- Reuse Boot's console pattern when set; otherwise the CRLF-safe CONSOLE_LOG_PATTERN property
                 above (a <Property> rather than a ':-' default, whose parser chokes on '{'). -->
            <PatternLayout pattern="${sys:CONSOLE_LOG_PATTERN}"/>
        </Console>

        <!-- Audit logs: the message IS the JSON event; no decoration, so each line is valid JSON. Serialised
             JSON never contains a raw CR/LF, so %enc{..}{CRLF} leaves it unchanged; it only guarantees that a
             non-JSON message cannot split the one-event-per-line stream. -->
        <Console name="AuditConsole" target="SYSTEM_OUT">
            <PatternLayout pattern="%enc{%m}{CRLF}%n"/>
        </Console>

        <!--
        Optional SIEM transports (enable by un-commenting and adding the AppenderRef to the helix.audit
        logger). These ship audit JSON over the log pipeline instead of, or in addition to, the in-app
        HTTP push.

        <Syslog name="AuditSyslog" format="RFC5424" host="${env:HELIX_AUDIT_SYSLOG_HOST}"
                port="${env:HELIX_AUDIT_SYSLOG_PORT:-6514}" protocol="TCP" appName="helix-iam"
                facility="LOCAL0" enterpriseNumber="32473" newLine="true" messageId="audit">
            <PatternLayout pattern="%m"/>
        </Syslog>

        <Http name="AuditHttp" url="${env:HELIX_AUDIT_HTTP_URL}">
            <Property name="Content-Type" value="application/json"/>
            <PatternLayout pattern="%m"/>
        </Http>
        -->
    </Appenders>

    <Loggers>
        <!-- Pure-JSON audit stream; additivity=false keeps it out of the app-formatted console. -->
        <Logger name="helix.audit" level="INFO" additivity="false">
            <AppenderRef ref="AuditConsole"/>
        </Logger>

        <Root level="INFO">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
