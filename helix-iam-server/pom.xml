<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot 4.1 (Spring Framework 7.0, Spring Security 7.1 incl. the authorization server, Hibernate 7,
         Tomcat 11, Jakarta EE 11). Spring Framework 6.2 left open-source support on 2026-06-30; 7.0.9 is the first
         public release that fixes CVE-2026-47884 / CVE-2026-47890 (spring-webmvc). -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>io.helixiam</groupId>
    <artifactId>helix-iam-server</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>HelixIAM Server</name>
    <description>Standalone HelixIAM identity server (merged OAuth2/OIDC/SAML front + identity domain; no message broker).</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Security review L1: guava arrives transitively (OpenSAML / Shibboleth stack) at 31.1-jre,
             which is vulnerable to CVE-2023-2976 + CVE-2020-8908 (world-readable temp directories created
             by Files.createTempDir / FileBackedOutputStream). Both are fixed from 32.0.1-jre; 33.4.0-jre is
             the newest line that resolves in this offline (mvn -o) build with its own transitive metadata
             intact (failureaccess / listenablefuture). Pinned via the dependencyManagement block below. -->
        <guava.version>33.7.2-jre</guava.version>
        <!-- Security review M7 (DONE): OpenSAML 4.3.2 is EOL. HelixIAM uses OpenSAML directly (SAML2 IdP,
             SAML broker, eID broker) on the current 5.2.x line, declared below. OpenSAML 5 replaces
             net.shibboleth.utilities:java-support:8.x with net.shibboleth:shib-support:9.2.x (the
             net.shibboleth.shared.* repackaging). xmlsec and cryptacular follow the Shibboleth 17.2.3 parent
             that OpenSAML 5.2.3 is built with (xmlsec 3.0.6, cryptacular 1.3.0); everything is pinned in
             dependencyManagement so no 4.x / java-support / xmlsec 2.x can come back transitively.
             BouncyCastle is pinned uniformly at ${bouncycastle.version} (direct deps below, nearest-wins, newer
             than the parent's 1.84) so cryptacular cannot pull a split bcprov/bcpkix version. -->
        <opensaml.version>5.2.3</opensaml.version>
        <shibboleth.shared.version>9.2.3</shibboleth.shared.version>
        <xmlsec.version>3.0.6</xmlsec.version>
        <cryptacular.version>1.3.0</cryptacular.version>
        <!-- Security scan (Trivy) overrides on top of Spring Boot 4.1.1's dependency management:
             - Spring Boot 4.1.1 manages Spring Framework 7.0.9 (fixes CVE-2026-47884 / CVE-2026-47890 in
               spring-webmvc), Spring Security 7.1.1, Netty 4.2.x and pgjdbc 42.7.13, all newer than the 1.0 patch
               pins (netty 4.1.139.Final, pgjdbc 42.7.12), which are therefore dropped. Tomcat: see below.
             - BouncyCastle 1.86 (direct deps below): CVE-2025-14813, CVE-2026-0636, CVE-2026-5588,
               CVE-2026-8763, CVE-2026-13506. -->
        <bouncycastle.version>1.86</bouncycastle.version>
        <!-- Tomcat 11.0.24 (Boot 4.1.1-managed) -> 11.0.27: CVE-2026-65182 (CRITICAL access-control bypass),
             CVE-2026-65905, CVE-2026-68525 are fixed from 11.0.25. Boot's own tomcat.version property, so every
             tomcat-embed-* artifact moves together. -->
        <tomcat.version>11.0.27</tomcat.version>
        <!-- Boot does not manage Nimbus. SECURITY: CVE-2025-53864 / GHSA-xwmg-2g98-w7v9 (unbounded recursion on
             deeply nested JSON claim sets; affects < 9.37.4 and 9.38-rc1 .. < 10.0.2). Pinned to a patched 10.x
             release; NimbusNestedJsonRegressionTest guards it. -->
        <nimbus-jose-jwt.version>10.10</nimbus-jose-jwt.version>
        <!-- Jackson 3 (tools.jackson) is the application's JSON library: our code, Spring MVC's converters (Boot's
             spring-boot-jackson, spring.jackson.*), Spring Security 7, Flyway 12 and webauthn4j. Kept on the 3.2.x line
             webauthn4j 0.31.11 is built against (it was 3.2.3 on Boot 3.5 too); Boot 4.1.1 manages 3.1.5. -->
        <jackson-bom.version>3.2.3</jackson-bom.version>
        <!-- Jackson 2 (com.fasterxml.jackson) is no longer used by HelixIAM's code, but OpenSAML 5's opensaml-core-impl
             (jackson-databind, -datatype-jsr310, and metrics-json's jackson-core) and springdoc-openapi's swagger-core
             2.2.x (-dataformat-yaml; it builds /v3/api-docs with its own Jackson 2 mapper) still depend on it, so it
             stays on the runtime classpath. Boot 4.1.1 manages the
             Jackson 2 BOM at 2.21.5; 2.21.7 fixes CVE-2026-89407, CVE-2026-89425 (jackson-core DoS), CVE-2026-68497,
             CVE-2026-91776, CVE-2026-91777 (jackson-databind DoS).
             httpcore5/httpcore5-h2 5.4.3 (Boot-managed) -> 5.4.4 (via OpenSAML's httpclient5): CVE-2026-54399,
             CVE-2026-54428 (DoS via oversized headers). -->
        <jackson-2-bom.version>2.21.7</jackson-2-bom.version>
        <!-- One jackson-annotations for both lines: Jackson 3.2 needs 2.22 (e.g. JsonApplyView, used when Flyway 12 reads
             its configuration), the Jackson 2 BOM would pin 2.21. Annotations are backward compatible, so Jackson 2.21
             (swagger-core) runs unchanged on 2.22. -->
        <jackson-annotations.version>2.22</jackson-annotations.version>
        <httpcore5.version>5.4.4</httpcore5.version>
    </properties>

    <!-- Transitive-dependency version overrides (security review). Boot's parent does not manage guava,
         so this dependencyManagement entry is what forces the patched line onto every consumer of it. -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>${guava.version}</version>
            </dependency>

            <!-- ===== M7: the entire OpenSAML stack on the 5.2.x line (from EOL 4.3.2) ===== -->
            <!-- opensaml-core (4.x) was split into opensaml-core-api + opensaml-core-impl in 5.x. -->
            <dependency>
                <groupId>org.opensaml</groupId>
                <artifactId>opensaml-core-api</artifactId>
                <version>${opensaml.version}</version>
            </dependency>
            <dependency>
                <groupId>org.opensaml</groupId>
                <artifactId>opensaml-core-impl</artifactId>
                <version>${opensaml.version}</version>
            </dependency>
            <dependency>
                <groupId>org.opensaml</groupId>
                <artifactId>opensaml-saml-api</artifactId>
                <version>${opensaml.version}</version>
            </dependency>
            <dependency>
                <groupId>org.opensaml</groupId>
                <artifactId>opensaml-saml-impl</artifactId>
                <version>${opensaml.version}</version>
            </dependency>
            <dependency>
                <groupId>org.opensaml</groupId>
                <artifactId>opensaml-security-api</artifactId>
                <version>${opensaml.version}</version>
            </dependency>
            <dependency>
                <groupId>org.opensaml</groupId>
                <artifactId>opensaml-security-impl</artifactId>
                <version>${opensaml.version}</version>
            </dependency>
            <dependency>
                <groupId>org.opensaml</groupId>
                <artifactId>opensaml-xmlsec-api</artifactId>
                <version>${opensaml.version}</version>
            </dependency>
            <dependency>
                <groupId>org.opensaml</groupId>
                <artifactId>opensaml-xmlsec-impl</artifactId>
                <version>${opensaml.version}</version>
            </dependency>
            <dependency>
                <groupId>org.opensaml</groupId>
                <artifactId>opensaml-messaging-api</artifactId>
                <version>${opensaml.version}</version>
            </dependency>
            <dependency>
                <groupId>org.opensaml</groupId>
                <artifactId>opensaml-messaging-impl</artifactId>
                <version>${opensaml.version}</version>
            </dependency>
            <dependency>
                <groupId>org.opensaml</groupId>
                <artifactId>opensaml-profile-api</artifactId>
                <version>${opensaml.version}</version>
            </dependency>
            <dependency>
                <groupId>org.opensaml</groupId>
                <artifactId>opensaml-profile-impl</artifactId>
                <version>${opensaml.version}</version>
            </dependency>
            <dependency>
                <groupId>org.opensaml</groupId>
                <artifactId>opensaml-soap-api</artifactId>
                <version>${opensaml.version}</version>
            </dependency>
            <dependency>
                <groupId>org.opensaml</groupId>
                <artifactId>opensaml-soap-impl</artifactId>
                <version>${opensaml.version}</version>
            </dependency>
            <dependency>
                <groupId>org.opensaml</groupId>
                <artifactId>opensaml-storage-api</artifactId>
                <version>${opensaml.version}</version>
            </dependency>
            <dependency>
                <groupId>org.opensaml</groupId>
                <artifactId>opensaml-storage-impl</artifactId>
                <version>${opensaml.version}</version>
            </dependency>

            <!-- OpenSAML 5's repackaged Shibboleth shared libs (java-support:8.x -> shib-*:9.2.x). -->
            <dependency>
                <groupId>net.shibboleth</groupId>
                <artifactId>shib-support</artifactId>
                <version>${shibboleth.shared.version}</version>
            </dependency>
            <dependency>
                <groupId>net.shibboleth</groupId>
                <artifactId>shib-security</artifactId>
                <version>${shibboleth.shared.version}</version>
            </dependency>
            <dependency>
                <groupId>net.shibboleth</groupId>
                <artifactId>shib-networking</artifactId>
                <version>${shibboleth.shared.version}</version>
            </dependency>
            <dependency>
                <groupId>net.shibboleth</groupId>
                <artifactId>shib-velocity</artifactId>
                <version>${shibboleth.shared.version}</version>
            </dependency>

            <!-- OpenSAML 5 crypto/XML-signature transitives: keep them current + convergent. -->
            <dependency>
                <groupId>org.apache.santuario</groupId>
                <artifactId>xmlsec</artifactId>
                <version>${xmlsec.version}</version>
            </dependency>
            <dependency>
                <groupId>org.cryptacular</groupId>
                <artifactId>cryptacular</artifactId>
                <version>${cryptacular.version}</version>
            </dependency>

            <!-- One patched Nimbus (CVE-2025-53864) for SAS (transitive 9.37.4 / 9.47) and the EUDI Wallet
                 verifier (direct). -->
            <dependency>
                <groupId>com.nimbusds</groupId>
                <artifactId>nimbus-jose-jwt</artifactId>
                <version>${nimbus-jose-jwt.version}</version>
            </dependency>

            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-annotations</artifactId>
                <version>${jackson-annotations.version}</version>
            </dependency>
            <!-- Dependency-CVE sweep: see the property block above for the CVEs each bump fixes. -->
            <dependency>
                <groupId>org.apache.httpcomponents.core5</groupId>
                <artifactId>httpcore5</artifactId>
                <version>${httpcore5.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.httpcomponents.core5</groupId>
                <artifactId>httpcore5-h2</artifactId>
                <version>${httpcore5.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- ============ Web / SAS / OIDC / SAML front (from publisher) ============ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
            <exclusions>
                <!-- Log4j2 (spring-boot-starter-log4j2 below), not Logback. -->
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- Boot 4: the authorization server is part of Spring Security 7 (spring-security-oauth2-authorization-server
             7.x); the starter was renamed from spring-boot-starter-oauth2-authorization-server. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-authorization-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- SAML (M7): OpenSAML 5, used directly by the SAML2 IdP (idp/saml), the SAML broker (federation/saml)
             and the eID broker (federation/eid). It lives in the Shibboleth repository, declared below. HelixIAM
             references no org.springframework.security.saml2 class, so spring-security-saml2-service-provider
             (whose 6.5.x POM still depends on OpenSAML 4.3.2) is no longer on the tree. -->
        <dependency>
            <groupId>org.opensaml</groupId>
            <artifactId>opensaml-saml-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.opensaml</groupId>
            <artifactId>opensaml-saml-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>net.shibboleth</groupId>
            <artifactId>shib-support</artifactId>
        </dependency>

        <!-- ============ Identity domain + persistence (from subscriber; de-mfnr'd) ============ -->
        <!-- Replaces mfnr-subscriber-starter-database-postgres: standard JPA + Postgres driver.
             The vendored io.helixiam.persistence.* (from starter-database) provides AttributeEncryption,
             FilterSpecification and optional read/write routing on top of this. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Versioned schema migrations. Boot 4 moved the Flyway auto-configuration into its own module, so the
             starter is required (flyway-core alone no longer triggers spring.flyway.*). Flyway version: Boot-managed. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- ============ Session (KEEP Redis, per decision) ============ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-session-data-redis</artifactId>
        </dependency>

        <!-- ============ Crypto / MFA / passkeys ============ -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>${bouncycastle.version}</version>
        </dependency>
        <!-- Pin bcpkix/bcutil to match bcprov — OpenSAML (via cryptacular) drags in 1.72,
             and the split versions collide (NoClassDefFoundError OperatorHelper) once both the
             SAML stack and the passkey/MFA stack share one classpath (strip-RabbitMQ merge). -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcpkix-jdk18on</artifactId>
            <version>${bouncycastle.version}</version>
        </dependency>
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcutil-jdk18on</artifactId>
            <version>${bouncycastle.version}</version>
        </dependency>
        <dependency>
            <groupId>com.j256.two-factor-auth</groupId>
            <artifactId>two-factor-auth</artifactId>
            <version>1.3</version>
        </dependency>
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>javase</artifactId>
            <version>3.5.4</version>
        </dependency>
        <dependency>
            <groupId>com.webauthn4j</groupId>
            <artifactId>webauthn4j-core</artifactId>
            <version>0.31.11.RELEASE</version>
        </dependency>
        <!-- mdoc (ISO 18013-5) decoding, StrictCbor. Jackson 3, as is webauthn4j's. -->
        <dependency>
            <groupId>tools.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-cbor</artifactId>
        </dependency>
        <!-- EUDI Wallet verifier: SD-JWT / KB-JWT / JWE on Nimbus. Declared directly (it was only transitive via
             SAS); version comes from dependencyManagement above. -->
        <dependency>
            <groupId>com.nimbusds</groupId>
            <artifactId>nimbus-jose-jwt</artifactId>
        </dependency>

        <!-- ============ Notifications (de-mfnr'd): direct SMTP, no broker ============
             Replaces mfnr-subscriber-starter-notification's AMQP emit. The vendored
             io.helixiam.notification.* keeps OTP code generation/storage; delivery goes through
             a pluggable Notifier (SMTP impl uses Jakarta Mail below; HTTP-webhook + log impls too). -->
        <dependency>
            <groupId>jakarta.mail</groupId>
            <artifactId>jakarta.mail-api</artifactId>
            <version>2.1.5</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.angus</groupId>
            <artifactId>angus-mail</artifactId>
            <version>2.0.5</version>
            <exclusions>
                <exclusion>
                    <groupId>jakarta.mail</groupId>
                    <artifactId>jakarta.mail-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- ============ Observability + API docs ============ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.1.1</version>
        </dependency>

        <!-- ============ Config / misc ============ -->
        <!-- Realm config folders (RealmConfigFolderLoader). Jackson 3: the application's JSON is on tools.jackson,
             auto-configured by Boot's spring-boot-jackson (spring.jackson.*, see application.properties). -->
        <dependency>
            <groupId>tools.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
        </dependency>

        <!-- Logging: both source trees use Log4j2 (default logback excluded above/below). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-log4j2</artifactId>
        </dependency>

        <!--
            Security review L4: spring-boot-devtools was REMOVED from the build. `<optional>true</optional>`
            keeps it out of *downstream consumers*, not out of this application's own compile/runtime
            classpath or its repackaged jar — devtools ships an auto-restart classloader and a LiveReload
            server, neither of which belongs anywhere near a production IdP. Nothing in this source tree
            references devtools APIs, so removing it does not affect compilation; a developer who wants
            live restart can re-add it in a personal profile.
        -->

        <!-- ============ Test ============ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- Boot 4 split the test auto-configuration per technology (MockMvc, TestRestTemplate, JPA slices,
             Spring Security test support). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-resttestclient</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Embedded LDAP for the federation/LDAP-broker tests (from publisher). -->
        <dependency>
            <groupId>com.unboundid</groupId>
            <artifactId>unboundid-ldapsdk</artifactId>
            <version>7.0.5</version>
            <scope>test</scope>
        </dependency>
        <!-- Postgres integration tests for the merged app (new: replaces AMQP round-trip tests). -->
        <!-- Testcontainers 2 (Boot-managed): modules carry a testcontainers- prefix. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Real-browser e2e harness (io.helixiam.e2e.browser): Playwright drives a headless Chromium that it
             downloads on first use (~/.cache/ms-playwright or ~/Library/Caches/ms-playwright), for macOS arm64
             and Linux x86-64/arm64 alike, so the browser runs on the host next to the embedded IdP and the test
             relying party: no container, no host-port exposure, one issuer for browser, RP back-channel and
             token validation. -->
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>1.63.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- Task 25: runs io.helixiam.testwallet.TestWalletCli (src/test/java, never in the main jar or the
                 server image) as a small standalone tool for the sandbox "Sign in with EUDI Wallet" demo. No
                 execution is bound to a lifecycle phase, so `mvn package`/the Docker build never invokes it; it is
                 only ever run explicitly:
                 mvn -q -pl helix-iam-server exec:java -Dexec.classpathScope=test \
                   -Dexec.mainClass=io.helixiam.testwallet.TestWalletCli -Dexec.args="..." -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.4</version>
            </plugin>
            <!-- rc.6 item 1: the e2e context uses the Redis session store. This second run starts its own
                 JVM + context with the queue (PostgreSQL) store, as `HELIX_SESSION_STORE=queue` does in
                 production, and repeats the browser tests whose sessions carry the most state: the account
                 console (flash attributes, step-up, sign out elsewhere) and the sign-in journeys. On this store the
                 EUDI wallet logins keep their transactions in PostgreSQL (JdbcWalletTransactionStore), so the wallet
                 tests here cover that store booted end to end. Run one class
                 on the queue store locally with `-Dtest=… -Dhelix.iam.session-store=queue`. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <executions>
                    <execution>
                        <id>browser-on-queue-session-store</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>io/helixiam/e2e/browser/AccountConsoleBrowserE2eTest.java</include>
                                <include>io/helixiam/e2e/browser/CrossOriginSignInBrowserE2eTest.java</include>
                                <include>io/helixiam/e2e/browser/FederatedSessionRotationBrowserE2eTest.java</include>
                                <include>io/helixiam/e2e/browser/MfaGateBrowserE2eTest.java</include>
                                <include>io/helixiam/e2e/browser/RegistrationReturnBrowserE2eTest.java</include>
                                <include>io/helixiam/e2e/browser/RegistrationVerificationBrowserE2eTest.java</include>
                                <include>io/helixiam/e2e/browser/WalletLoginBrowserE2eTest.java</include>
                                <include>io/helixiam/e2e/browser/WalletLinkBrowserE2eTest.java</include>
                                <include>io/helixiam/e2e/WalletTwoRealmsOneBrowserE2eTest.java</include>
                            </includes>
                            <systemPropertyVariables>
                                <helix.iam.session-store>queue</helix.iam.session-store>
                            </systemPropertyVariables>
                            <reportsDirectory>${project.build.directory}/surefire-reports-queue-session-store</reportsDirectory>
                            <!-- `-Dtest=SomeOtherTest` selects nothing here; that is not a failure. -->
                            <failIfNoSpecifiedTests>false</failIfNoSpecifiedTests>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <repositories>
        <!-- OpenSAML (org.opensaml:*) is not on Maven Central. -->
        <repository>
            <id>shibboleth-releases</id>
            <url>https://build.shibboleth.net/maven/releases/</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
    </repositories>

</project>
