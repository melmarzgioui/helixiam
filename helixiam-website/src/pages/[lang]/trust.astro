---
import Base from "../../layouts/Base.astro";
import TrustView from "../../components/views/TrustView.astro";
import { trust } from "../../pagedata/trust";
import type { Locale } from "../../i18n";
export function getStaticPaths() { return [{ params: { lang: "fr" } }, { params: { lang: "nl" } }]; }
const locale = Astro.params.lang as Locale;
const S = trust[locale];
---
<Base title={S.metaTitle} description={S.metaDesc} translated={true}>
  <TrustView />
</Base>
