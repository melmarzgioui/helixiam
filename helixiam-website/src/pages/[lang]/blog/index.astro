---
import Base from "../../../layouts/Base.astro";
import BlogView from "../../../components/views/BlogView.astro";
import { blog } from "../../../pagedata/blog";
import type { Locale } from "../../../i18n";
export function getStaticPaths() { return [{ params: { lang: "fr" } }, { params: { lang: "nl" } }]; }
const locale = Astro.params.lang as Locale;
const S = blog[locale];
---
<Base title={S.metaTitle} description={S.metaDesc} translated={true}>
  <BlogView />
</Base>
