---
import Base from "../../../layouts/Base.astro";
import ProductIndexView from "../../../components/views/ProductIndexView.astro";
import { productIndex } from "../../../pagedata/product-index";
import type { Locale } from "../../../i18n";
export function getStaticPaths() { return [{ params: { lang: "fr" } }, { params: { lang: "nl" } }]; }
const locale = Astro.params.lang as Locale;
const S = productIndex[locale];
---
<Base title={S.metaTitle} description={S.metaDesc} translated={true}>
  <ProductIndexView />
</Base>
