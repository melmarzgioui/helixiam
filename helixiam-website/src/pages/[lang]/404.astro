---
import Base from "../../layouts/Base.astro";
import NotFoundView from "../../components/views/NotFoundView.astro";
import { notfound } from "../../pagedata/notfound";
import type { Locale } from "../../i18n";
export function getStaticPaths() { return [{ params: { lang: "fr" } }, { params: { lang: "nl" } }]; }
const locale = Astro.params.lang as Locale;
const S = notfound[locale];
---
<Base title={S.metaTitle} noindex={true}>
  <NotFoundView />
</Base>
