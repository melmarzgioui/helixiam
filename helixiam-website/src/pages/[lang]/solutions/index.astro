---
import Base from "../../../layouts/Base.astro";
import SolutionsIndexView from "../../../components/views/SolutionsIndexView.astro";
import { solutionsIndex } from "../../../pagedata/solutions-index";
import type { Locale } from "../../../i18n";
export function getStaticPaths() { return [{ params: { lang: "fr" } }, { params: { lang: "nl" } }]; }
const locale = Astro.params.lang as Locale;
const S = solutionsIndex[locale];
---
<Base title={S.metaTitle} description={S.metaDesc} translated={true}>
  <SolutionsIndexView />
</Base>
