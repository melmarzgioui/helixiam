---
import Base from "../../layouts/Base.astro";
import WhyHelixiamView from "../../components/views/WhyHelixiamView.astro";
import { whyHelixiam } from "../../pagedata/why-helixiam";
import type { Locale } from "../../i18n";
export function getStaticPaths() { return [{ params: { lang: "fr" } }, { params: { lang: "nl" } }]; }
const locale = Astro.params.lang as Locale;
const S = whyHelixiam[locale];
---
<Base title={S.metaTitle} description={S.metaDesc} translated={true}>
  <WhyHelixiamView />
</Base>
