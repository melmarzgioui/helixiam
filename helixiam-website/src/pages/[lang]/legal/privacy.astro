---
import Legal from "../../../layouts/Legal.astro";
import { privacy } from "../../../pagedata/legal";
import type { Locale } from "../../../i18n";
export function getStaticPaths() { return [{ params: { lang: "fr" } }, { params: { lang: "nl" } }]; }
const S = privacy[Astro.params.lang as Locale];
---
<Legal title={S.metaTitle} updated={S.updated} description={S.metaDesc}>
  <Fragment set:html={S.bodyHtml} />
</Legal>
