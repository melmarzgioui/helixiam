---
import Base from "../../../layouts/Base.astro";
import CompanyView from "../../../components/views/CompanyView.astro";
import { company } from "../../../pagedata/company";
import type { Locale } from "../../../i18n";
export function getStaticPaths() { return [{ params: { lang: "fr" } }, { params: { lang: "nl" } }]; }
const locale = Astro.params.lang as Locale;
const S = company[locale];
---
<Base title={S.metaTitle} description={S.metaDesc} translated={true}>
  <CompanyView />
</Base>
