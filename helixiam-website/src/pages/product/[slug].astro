---
import Base from "../../layouts/Base.astro";
import ProductFeatureView from "../../components/views/ProductFeatureView.astro";
import { featuresFor } from "../../data/product";
export function getStaticPaths() {
  return featuresFor("en").map((f) => ({ params: { slug: f.slug }, props: { f } }));
}
const { f } = Astro.props;
---
<Base title={f.navLabel} description={f.metaDesc} translated={true}>
  <ProductFeatureView f={f} />
</Base>
