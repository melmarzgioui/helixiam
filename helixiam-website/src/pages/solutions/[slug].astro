---
import Base from "../../layouts/Base.astro";
import SolutionDetailView from "../../components/views/SolutionDetailView.astro";
import { solutionsFor } from "../../data/solutions";
export function getStaticPaths() {
  return solutionsFor("en").map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props;
---
<Base title={s.navLabel} description={s.metaDesc} translated={true}>
  <SolutionDetailView s={s} />
</Base>
