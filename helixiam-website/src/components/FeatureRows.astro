---
import Icon from "./Icon.astro";
// Alternating content rows: prose on one side, a bulleted "spec card" on the other.
interface Row { heading: string; body: string; bullets: string[]; icon?: string; }
interface Props { rows: Row[]; }
const { rows } = Astro.props;
---
<div class="frows">
  {rows.map((r, i) => (
    <div class={`frow reveal ${i % 2 ? "alt" : ""}`}>
      <div class="frow-copy">
        {r.icon && <span class="frow-ico"><Icon name={r.icon} size={20} /></span>}
        <h3>{r.heading}</h3>
        <p>{r.body}</p>
      </div>
      <div class="card frow-card">
        <ul>
          {r.bullets.map((b) => <li><Icon name="check" size={15} />{b}</li>)}
        </ul>
      </div>
    </div>
  ))}
</div>

<style>
  .frows { display: grid; gap: 1.6rem; }
  .frow { display: grid; grid-template-columns: 1fr 1fr; gap: 2.5rem; align-items: center; }
  .frow.alt .frow-copy { order: 2; }
  .frow-ico { display: inline-flex; width: 42px; height: 42px; align-items: center; justify-content: center; border-radius: 11px; color: var(--jade); background: rgba(94, 234, 212, 0.08); border: 1px solid rgba(94, 234, 212, 0.2); margin-bottom: 0.9rem; }
  .frow-copy h3 { margin-bottom: 0.5rem; }
  .frow-card ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.6rem; }
  .frow-card li { display: flex; align-items: flex-start; gap: 0.6rem; color: var(--slate); font-size: 0.95rem; }
  .frow-card svg { color: var(--spring); flex-shrink: 0; margin-top: 0.15rem; }
  @media (max-width: 820px) {
    .frow { grid-template-columns: 1fr; gap: 1.2rem; }
    .frow.alt .frow-copy { order: 0; }
  }
</style>
