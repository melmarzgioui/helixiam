---
// HelixIAM signature hero: "The Identity Genome".
// A depth-tilted circular genome (the Helix motif — a ring, not a double helix). Two backbones are
// tinted human (cyan) vs non-human (iris); base-pair rungs carry A·T·C·G; genes on the rim are
// identity claims. A reading head sweeps the sequence and resolves it into a central identity core
// that cycles human → AI agent → workload and pulses "verified". Canvas 2D, DPR-aware, pauses
// offscreen, honours prefers-reduced-motion (renders one elegant static frame).
---
<div class="genome" aria-hidden="true">
  <canvas id="identityGenome"></canvas>
</div>

<style>
  .genome { position: relative; width: 100%; aspect-ratio: 1 / 1; max-width: 560px; margin-inline: auto; }
  .genome canvas { width: 100%; height: 100%; display: block; }
</style>

<script>
  const cv = document.getElementById("identityGenome") as HTMLCanvasElement | null;
  if (cv) {
    const ctx = cv.getContext("2d")!;
    const C = { cyan: "#5eead4", jade: "#a3d4c4", spring: "#34e0b0", iris: "#8f8bff", ink: "#e8eef2", slate: "#8296a8", faint: "#5a6b7b", void: "#060a12" };
    const TAU = Math.PI * 2;
    const rgb = (h: string) => { const n = parseInt(h.slice(1), 16); return [(n >> 16) & 255, (n >> 8) & 255, n & 255]; };
    const rgba = (h: string, a: number) => { const c = rgb(h); return `rgba(${c[0]},${c[1]},${c[2]},${a})`; };
    const BCOL: Record<string, string> = { A: C.jade, T: C.cyan, C: C.iris, G: C.spring };
    const baseAt = (i: number) => "ATCG"[(i * 7 + ((i * i) % 11)) & 3];

    function sprite(color: string, size = 40) {
      const s = document.createElement("canvas"); s.width = s.height = size; const c = s.getContext("2d")!;
      const g = c.createRadialGradient(size / 2, size / 2, 0, size / 2, size / 2, size / 2);
      g.addColorStop(0, rgba(color, 1)); g.addColorStop(0.4, rgba(color, 0.45)); g.addColorStop(1, rgba(color, 0));
      c.fillStyle = g; c.fillRect(0, 0, size, size); return s;
    }
    const glowCyan = sprite(C.cyan), glowIris = sprite(C.iris), glowSpring = sprite(C.spring);

    // genes = identity claims sitting on the genome
    const GENES = [
      { lab: "sub", a0: 0.15, a1: 1.05, col: C.cyan },
      { lab: "role", a0: 1.35, a1: 2.05, col: C.iris },
      { lab: "scope", a0: 2.4, a1: 3.35, col: C.spring },
      { lab: "act", a0: 3.7, a1: 4.35, col: C.iris },
      { lab: "realm", a0: 4.7, a1: 5.45, col: C.jade },
      { lab: "aud", a0: 5.75, a1: 6.15, col: C.cyan },
    ];
    const SUBJECTS = [
      { key: "human", label: "human identity", col: C.cyan },
      { key: "agent", label: "AI agent", col: C.iris },
      { key: "workload", label: "workload", col: C.spring },
    ];

    const RUNGS = 84;
    // ambient depth motes
    const motes = Array.from({ length: 70 }, () => ({ a: Math.random() * TAU, r: 0.2 + Math.random() * 1.1, s: 0.3 + Math.random() * 1.4, spd: 0.2 + Math.random() * 0.6, ph: Math.random() * TAU }));

    let W = 0, H = 0, DPR = 1;
    function resize() { const r = cv!.getBoundingClientRect(); DPR = Math.min(2, window.devicePixelRatio || 1); cv!.width = Math.max(1, r.width * DPR); cv!.height = Math.max(1, r.height * DPR); ctx.setTransform(DPR, 0, 0, DPR, 0, 0); W = r.width; H = r.height; }
    resize();
    let ro: ResizeObserver | null = null;
    if ("ResizeObserver" in window) { ro = new ResizeObserver(() => resize()); ro.observe(cv); } else window.addEventListener("resize", resize);

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let visible = true;
    if ("IntersectionObserver" in window) { new IntersectionObserver((e) => (visible = e[0].isIntersecting), { threshold: 0.01 }).observe(cv); }

    // draws the whole scene at time t (seconds). `head` = reading-head angle.
    function scene(t: number) {
      const cx = W / 2, cy = H / 2, S = Math.min(W, H), R = S * 0.28, tilt = 0.6;
      const rot = t * 0.13, gap = S * 0.028;
      ctx.clearRect(0, 0, W, H);

      // ambient motes (depth)
      ctx.globalCompositeOperation = "lighter";
      for (const m of motes) { const a = m.a + t * m.spd * 0.15; const rr = R * (1.35 + 0.5 * Math.sin(t * 0.2 + m.ph)) * m.r; const x = cx + Math.cos(a) * rr, y = cy + Math.sin(a) * rr * tilt; const al = 0.06 + 0.06 * (Math.sin(t + m.ph) * 0.5 + 0.5); const sp = m.r > 0.8 ? glowIris : glowCyan; const sz = m.s * S * 0.02; ctx.globalAlpha = al; ctx.drawImage(sp, x - sz / 2, y - sz / 2, sz, sz); }
      ctx.globalAlpha = 1;

      const head = (t * 0.55) % TAU; // reading head sweeps clockwise

      // build rung geometry, depth-sorted (draw back first)
      type P = { i: number; a: number; ox: number; oy: number; ix: number; iy: number; z: number; base: string };
      const pts: P[] = [];
      for (let i = 0; i < RUNGS; i++) {
        const a = rot + (i / RUNGS) * TAU; const twist = Math.sin(i * 0.6 + t * 0.4) * gap * 0.5;
        const ro2 = R + gap + twist, ri2 = R - gap + twist;
        pts.push({ i, a, ox: cx + Math.cos(a) * ro2, oy: cy + Math.sin(a) * ro2 * tilt, ix: cx + Math.cos(a) * ri2, iy: cy + Math.sin(a) * ri2 * tilt, z: Math.sin(a), base: baseAt(i) });
      }
      pts.sort((p, q) => (p.oy + p.iy) - (q.oy + q.iy));

      ctx.textAlign = "center"; ctx.textBaseline = "middle";
      for (const p of pts) {
        const depth = (p.z + 1) / 2;              // 0 back .. 1 front
        const near = Math.cos(p.a - head);         // reading-head proximity
        const lit = Math.max(0, near) ** 8;        // sharp highlight under the head
        const baseA = 0.28 + depth * 0.5;
        // rung (base pair)
        ctx.strokeStyle = rgba(BCOL[p.base], baseA * (0.5 + lit * 0.5)); ctx.lineWidth = 1 + depth * 1.3 + lit * 2; ctx.beginPath(); ctx.moveTo(p.ox, p.oy); ctx.lineTo(p.ix, p.iy); ctx.stroke();
        // backbones: outer = human (cyan), inner = non-human (iris)
        const bs = (0.9 + depth * 1.8);
        ctx.fillStyle = rgba(C.cyan, 0.35 + depth * 0.5); ctx.beginPath(); ctx.arc(p.ox, p.oy, bs, 0, TAU); ctx.fill();
        ctx.fillStyle = rgba(C.iris, 0.35 + depth * 0.5); ctx.beginPath(); ctx.arc(p.ix, p.iy, bs, 0, TAU); ctx.fill();
      }

      // gene arcs (identity claims) on the rim — pure colored accents that light up as the head
      // passes. Labels intentionally omitted: the claim names are detail for deeper pages; on the
      // hero they'd crowd the ring. The arcs alone read as "segments on the genome".
      for (const g of GENES) {
        const am = rot + (g.a0 + g.a1) / 2; const near = Math.max(0, Math.cos(am - head)) ** 6;
        ctx.strokeStyle = rgba(g.col, 0.4 + near * 0.5); ctx.lineWidth = 4 + near * 3; ctx.shadowColor = g.col; ctx.shadowBlur = 8 + near * 22; ctx.lineCap = "round";
        ctx.beginPath(); ctx.ellipse(cx, cy, R + gap + S * 0.03, (R + gap + S * 0.03) * tilt, 0, rot + g.a0, rot + g.a1); ctx.stroke();
        ctx.shadowBlur = 0; ctx.lineCap = "butt";
      }

      // reading head + filament to the identity core
      const hx = cx + Math.cos(head) * (R + gap), hy = cy + Math.sin(head) * (R + gap) * tilt;
      ctx.globalCompositeOperation = "lighter";
      const fg = ctx.createLinearGradient(hx, hy, cx, cy); fg.addColorStop(0, rgba(C.spring, 0.55)); fg.addColorStop(1, rgba(C.spring, 0));
      ctx.strokeStyle = fg; ctx.lineWidth = 1.5; ctx.beginPath(); ctx.moveTo(hx, hy); ctx.lineTo(cx, cy); ctx.stroke();
      const hs = S * 0.06; ctx.globalAlpha = 0.9; ctx.drawImage(glowSpring, hx - hs / 2, hy - hs / 2, hs, hs); ctx.globalAlpha = 1;
      ctx.globalCompositeOperation = "source-over";

      // ---- central identity core: DNA resolves into an identity, cycling subject ----
      const period = 4.2; const idx = Math.floor(t / period) % SUBJECTS.length; const f = (t % period) / period; const subj = SUBJECTS[idx];
      const appear = Math.min(1, f / 0.18), verify = f > 0.8 ? (f - 0.8) / 0.2 : 0;
      const pulse = 1 + Math.sin(t * 2.2) * 0.03;
      const coreR = S * 0.1 * pulse;
      // aura
      ctx.globalCompositeOperation = "lighter"; const sp = subj.col === C.iris ? glowIris : subj.col === C.spring ? glowSpring : glowCyan;
      const az = S * 0.42; ctx.globalAlpha = 0.5 + verify * 0.4; ctx.drawImage(sp, cx - az / 2, cy - az / 2, az, az); ctx.globalAlpha = 1; ctx.globalCompositeOperation = "source-over";
      // disc
      ctx.beginPath(); ctx.arc(cx, cy, coreR, 0, TAU); ctx.fillStyle = rgba(C.void, 0.65); ctx.fill(); ctx.strokeStyle = rgba(subj.col, 0.85); ctx.lineWidth = 1.5; ctx.shadowColor = subj.col; ctx.shadowBlur = 22; ctx.stroke(); ctx.shadowBlur = 0;
      // subject glyph (morph via crossfade on switch)
      ctx.save(); ctx.translate(cx, cy); ctx.globalAlpha = appear; ctx.strokeStyle = rgba(subj.col, 0.95); ctx.fillStyle = rgba(subj.col, 0.95); ctx.lineWidth = 2; const g = coreR * 0.5;
      if (subj.key === "human") { ctx.beginPath(); ctx.arc(0, -g * 0.35, g * 0.42, 0, TAU); ctx.stroke(); ctx.beginPath(); ctx.arc(0, g * 0.9, g * 0.8, Math.PI, TAU); ctx.stroke(); }
      else if (subj.key === "agent") { ctx.beginPath(); for (let k = 0; k < 6; k++) { const a = -Math.PI / 2 + k * TAU / 6; const x = Math.cos(a) * g * 0.8, y = Math.sin(a) * g * 0.8; k ? ctx.lineTo(x, y) : ctx.moveTo(x, y); } ctx.closePath(); ctx.stroke(); ctx.beginPath(); ctx.arc(0, 0, g * 0.18, 0, TAU); ctx.fill(); }
      else { ctx.strokeRect(-g * 0.7, -g * 0.55, g * 1.4, g * 1.1); ctx.beginPath(); ctx.moveTo(-g * 0.7, -g * 0.15); ctx.lineTo(g * 0.7, -g * 0.15); ctx.moveTo(-g * 0.7, g * 0.25); ctx.lineTo(g * 0.7, g * 0.25); ctx.stroke(); }
      ctx.restore();
      // verified badge pulse
      if (verify > 0) { ctx.globalAlpha = verify; const bx = cx + coreR * 0.72, by = cy - coreR * 0.72; ctx.beginPath(); ctx.arc(bx, by, S * 0.028, 0, TAU); ctx.fillStyle = C.spring; ctx.shadowColor = C.spring; ctx.shadowBlur = 16; ctx.fill(); ctx.shadowBlur = 0; ctx.strokeStyle = C.void; ctx.lineWidth = 2; ctx.beginPath(); ctx.moveTo(bx - S * 0.012, by); ctx.lineTo(bx - S * 0.003, by + S * 0.009); ctx.lineTo(bx + S * 0.013, by - S * 0.011); ctx.stroke(); ctx.globalAlpha = 1; }
      // subject caption — single clean word (human identity / AI agent / workload)
      ctx.globalAlpha = appear; ctx.textAlign = "center"; ctx.fillStyle = rgba(C.ink, 0.92); ctx.font = `600 ${S * 0.034}px 'Work Sans', system-ui, sans-serif`; ctx.fillText(subj.label, cx, cy - coreR - S * 0.05); ctx.globalAlpha = 1;
      ctx.textAlign = "left";
    }

    if (reduce) { scene(6.2); }
    else { let raf = 0; const loop = (ms: number) => { if (visible) scene(ms / 1000); raf = requestAnimationFrame(loop); }; raf = requestAnimationFrame(loop); }
  }
</script>
