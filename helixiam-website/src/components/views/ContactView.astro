---
import LeadForm from "../LeadForm.astro";
import Icon from "../Icon.astro";
import { SITE } from "../../consts";
import { docsUrl, t, localizePath, localeOf, type Locale } from "../../i18n";
import { contact } from "../../pagedata/contact";
const locale: Locale = localeOf(Astro.url.pathname);
const L = (href: string) => localizePath(href, locale);
const S = contact[locale];
const C = t(locale).cta;
---
<section class="demo-wrap">
  <div class="container demo-grid">
    <div class="demo-copy">
      <span class="eyebrow">{S.eyebrow}</span>
      <h1 set:html={S.title}></h1>
      <p class="lead">{S.lead}</p>
      <div class="ct-cards">
        <a href={L("/demo/")} class="ct-card"><span class="ct-ico"><Icon name="eye" size={18} /></span><div><strong>{C.book}</strong><span>{S.demoSub}</span></div></a>
        <a href={docsUrl(locale)} target="_blank" rel="noopener" class="ct-card"><span class="ct-ico"><Icon name="code" size={18} /></span><div><strong>{C.docs}</strong><span>{S.docsSub}</span></div></a>
        <a href={`mailto:${SITE.email}`} class="ct-card"><span class="ct-ico"><Icon name="link" size={18} /></span><div><strong>{S.emailLabel}</strong><span>{SITE.email}</span></div></a>
      </div>
      <p class="ct-eu"><Icon name="eu" size={16} /> {S.euNote}</p>
    </div>
    <div class="demo-form card"><LeadForm kind="contact" /></div>
  </div>
</section>

<style>
  .demo-wrap { padding-block: clamp(2.5rem, 6vw, 4.5rem) var(--section-py); }
  .demo-grid { display: grid; grid-template-columns: 1fr 1.05fr; gap: 3rem; align-items: start; }
  .demo-copy h1 { font-size: clamp(2.2rem, 4.5vw, 3.2rem); }
  .ct-cards { display: grid; gap: 0.7rem; margin: 1.8rem 0; }
  .ct-card { display: flex; gap: 0.8rem; align-items: center; border: 1px solid var(--line); border-radius: var(--r); padding: 0.9rem 1.1rem; background: rgba(255, 255, 255, 0.015); }
  .ct-card:hover { border-color: var(--cyan); }
  .ct-ico { display: inline-flex; width: 38px; height: 38px; flex-shrink: 0; align-items: center; justify-content: center; border-radius: 10px; color: var(--jade); background: rgba(94, 234, 212, 0.08); border: 1px solid rgba(94, 234, 212, 0.2); }
  .ct-card strong { display: block; color: var(--ink); }
  .ct-card span { color: var(--slate); font-size: 0.88rem; }
  .ct-eu { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--faint); font-size: 0.86rem; }
  .ct-eu svg { color: var(--jade); }
  .demo-form { padding: 1.8rem; }
  @media (max-width: 900px) { .demo-grid { grid-template-columns: 1fr; gap: 2rem; } }
</style>
