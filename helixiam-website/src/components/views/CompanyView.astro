---
import PageHero from "../PageHero.astro";
import CtaBand from "../CtaBand.astro";
import Icon from "../Icon.astro";
import { localeOf, type Locale } from "../../i18n";
import { company } from "../../pagedata/company";

const locale: Locale = localeOf(Astro.url.pathname);
const S = company[locale];
---
<PageHero eyebrow={S.eyebrow} title={S.title} lead={S.lead} icon="layers" />

<section class="section">
  <div class="container">
    <div class="about-lead reveal">
      <p set:html={S.leadP1} />
      <p set:html={S.leadP2} />
      <p set:html={S.leadP3} />
    </div>

    <div class="val-grid">
      {S.values.map((v) => (
        <div class="card val reveal">
          <span class="val-ico"><Icon name={v.i} size={20} /></span>
          <h3>{v.t}</h3>
          <p>{v.d}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<CtaBand title={S.ctaTitle} sub={S.ctaSub} />

<style>
  .about-lead { max-width: 760px; margin-bottom: 3rem; }
  .about-lead p { font-size: 1.12rem; line-height: 1.75; }
  .about-lead strong { color: var(--ink); }
  .val-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; }
  .val-ico { display: inline-flex; width: 44px; height: 44px; align-items: center; justify-content: center; border-radius: 11px; color: var(--jade); background: rgba(94, 234, 212, 0.08); border: 1px solid rgba(94, 234, 212, 0.2); margin-bottom: 0.9rem; }
  @media (max-width: 720px) { .val-grid { grid-template-columns: 1fr; } }
</style>
