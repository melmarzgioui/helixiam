---
import PageHero from "../PageHero.astro";
import CtaBand from "../CtaBand.astro";
import Icon from "../Icon.astro";
import { localeOf, localizePath, type Locale } from "../../i18n";
import { whyHelixiam } from "../../pagedata/why-helixiam";

const locale: Locale = localeOf(Astro.url.pathname);
const L = (href: string) => localizePath(href, locale);
const S = whyHelixiam[locale];

const cell = (v: boolean | string) =>
  v === true ? "yes" : v === false ? "no" : v === "partial" ? "partial" : "na";
---
<PageHero eyebrow={S.eyebrow} title={S.title} lead={S.lead} icon="spark" />

<section class="section">
  <div class="container">
    <div class="diff-grid">
      {S.diffs.map((d) => (
        <a href={L(d.href)} class="card diff-card reveal">
          <span class="diff-ico"><Icon name={d.icon} size={22} /></span>
          <h3>{d.title}</h3>
          <p>{d.blurb}</p>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="sec-head reveal">
      <span class="eyebrow">{S.cmpEyebrow}</span>
      <h2>{S.cmpTitle}</h2>
      <p class="lead">{S.cmpLead}</p>
    </div>
    <div class="cmp reveal">
      <table>
        <thead>
          <tr><th scope="col">{S.colCapability}</th><th scope="col" class="col-h">HelixIAM</th><th scope="col">{S.colTypical}</th></tr>
        </thead>
        <tbody>
          {S.rows.map((r) => (
            <tr>
              <th scope="row">{r.f}</th>
              <td class={`c ${cell(r.h)}`}>{r.h === true ? "✓" : ""}</td>
              <td class={`c ${cell(r.k)}`}>{r.k === true ? "✓" : r.k === false ? "—" : r.k === "partial" ? S.partialLabel : S.naLabel}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="cmp-note">{S.cmpNote}</p>
    </div>
  </div>
</section>

<CtaBand title={S.ctaTitle} sub={S.ctaSub} />

<style>
  .diff-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.2rem; }
  .diff-card { display: flex; flex-direction: column; }
  .diff-ico { display: inline-flex; width: 46px; height: 46px; align-items: center; justify-content: center; border-radius: 12px; color: var(--void); background: var(--grad-cta); box-shadow: var(--glow-cyan); margin-bottom: 1rem; }
  .sec-head { max-width: 700px; margin-bottom: 2rem; }
  .cmp { border: 1px solid var(--line-2); border-radius: var(--r); overflow: hidden; }
  table { width: 100%; border-collapse: collapse; }
  th, td { text-align: left; padding: 0.9rem 1.1rem; border-bottom: 1px solid var(--line); font-size: 0.94rem; }
  thead th { color: var(--faint); font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.06em; background: rgba(255, 255, 255, 0.02); }
  thead .col-h { color: var(--jade); }
  tbody th { color: var(--ink); font-weight: 500; }
  td.c { text-align: center; font-weight: 700; }
  td.yes { color: var(--spring); }
  td.no { color: var(--faint); }
  td.partial, td.na { color: var(--slate); font-weight: 500; font-size: 0.82rem; }
  tbody tr:hover { background: rgba(94, 234, 212, 0.03); }
  .cmp-note { color: var(--faint); font-size: 0.8rem; padding: 0.9rem 1.1rem; margin: 0; }
  @media (max-width: 620px) { .diff-grid { grid-template-columns: 1fr; } th, td { padding: 0.7rem; font-size: 0.86rem; } }
</style>
