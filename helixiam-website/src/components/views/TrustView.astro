---
import PageHero from "../PageHero.astro";
import CtaBand from "../CtaBand.astro";
import Icon from "../Icon.astro";
import { localeOf, localizePath, type Locale } from "../../i18n";
import { trust } from "../../pagedata/trust";

const locale: Locale = localeOf(Astro.url.pathname);
const L = (href: string) => localizePath(href, locale);
const S = trust[locale];
---
<PageHero eyebrow={S.eyebrow} title={S.title} lead={S.lead} icon="shield" />

<section class="section">
  <div class="container">
    <div class="tr-grid">
      {S.practices.map((p) => (
        <div class="card tr reveal">
          <span class="tr-ico"><Icon name={p.i} size={20} /></span>
          <h3>{p.t}</h3>
          <ul>{p.items.map((i) => <li><Icon name="check" size={15} />{i}</li>)}</ul>
        </div>
      ))}
    </div>

    <div class="tr-note card reveal">
      <span class="chip"><Icon name="clock" size={14} />{S.roadmapChip}</span>
      <p>{S.roadmapBody}</p>
      <a href={L("/contact/")} class="btn btn-ghost">{S.roadmapCta}</a>
    </div>
  </div>
</section>

<CtaBand title={S.ctaTitle} sub={S.ctaSub} />

<style>
  .tr-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.2rem; }
  .tr-ico { display: inline-flex; width: 44px; height: 44px; align-items: center; justify-content: center; border-radius: 11px; color: var(--jade); background: rgba(94, 234, 212, 0.08); border: 1px solid rgba(94, 234, 212, 0.2); margin-bottom: 0.9rem; }
  .tr ul { list-style: none; padding: 0; margin: 0.6rem 0 0; display: grid; gap: 0.5rem; }
  .tr li { display: flex; align-items: flex-start; gap: 0.55rem; color: var(--slate); font-size: 0.9rem; }
  .tr li svg { color: var(--spring); flex-shrink: 0; margin-top: 0.15rem; }
  .tr-note { margin-top: 1.6rem; padding: 1.8rem; max-width: 900px; }
  .tr-note .chip { margin-bottom: 0.9rem; }
  .tr-note p { max-width: 72ch; }
  @media (max-width: 900px) { .tr-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 620px) { .tr-grid { grid-template-columns: 1fr; } }
</style>
