---
import PageHero from "../PageHero.astro";
import CtaBand from "../CtaBand.astro";
import Icon from "../Icon.astro";
import { featuresFor } from "../../data/product";
import { capabilitiesFor } from "../../consts";
import { t, localeOf, localizePath, type Locale } from "../../i18n";
import { productIndex } from "../../pagedata/product-index";

const locale: Locale = localeOf(Astro.url.pathname);
const L = (href: string) => localizePath(href, locale);
const S = productIndex[locale];
const U = t(locale).ui;
const FEATURES = featuresFor(locale);
const CAPABILITIES = capabilitiesFor(locale);
---
<PageHero eyebrow={S.eyebrow} title={S.title} lead={S.lead} icon="layers" />

<section class="section">
  <div class="container">
    <div class="prod-grid">
      {FEATURES.map((f) => (
        <a href={L(`/product/${f.slug}/`)} class="card prod reveal">
          <span class="prod-ico"><Icon name={f.icon} size={22} /></span>
          <h3>{f.navLabel}</h3>
          <p set:html={f.lead.split(".")[0] + "."}></p>
          <span class="prod-more">{U.explore}<Icon name="arrow" size={15} /></span>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="section cap-sec">
  <div class="container">
    <div class="sec-head reveal">
      <span class="eyebrow">{U.featureComplete}</span>
      <h2>{U.everythingShipped}</h2>
    </div>
    <div class="cap-grid">
      {CAPABILITIES.map((c) => (
        <div class="card cap reveal">
          <h4>{c.group}</h4>
          <ul>{c.items.map((i) => <li><span class="cdot"></span>{i}</li>)}</ul>
        </div>
      ))}
    </div>
  </div>
</section>

<CtaBand />

<style>
  .prod-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.2rem; }
  .prod { display: flex; flex-direction: column; }
  .prod-ico { display: inline-flex; width: 46px; height: 46px; align-items: center; justify-content: center; border-radius: 12px; color: var(--void); background: var(--grad-cta); box-shadow: var(--glow-cyan); margin-bottom: 1rem; }
  .prod p { flex: 1; font-size: 0.92rem; }
  .prod-more { display: inline-flex; align-items: center; gap: 0.3rem; color: var(--jade); font-weight: 600; font-size: 0.9rem; margin-top: 0.6rem; }
  .sec-head { max-width: 700px; margin-bottom: 2.4rem; }
  .cap-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.2rem; }
  .cap h4 { font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.09em; color: var(--jade); margin-bottom: 1rem; }
  .cap ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.55rem; }
  .cap li { display: flex; align-items: center; gap: 0.6rem; color: var(--slate); font-size: 0.92rem; }
  .cdot { width: 6px; height: 6px; border-radius: 50%; background: var(--jade-2); flex-shrink: 0; box-shadow: 0 0 8px rgba(94, 234, 212, 0.6); }
  @media (max-width: 900px) { .prod-grid, .cap-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 620px) { .prod-grid, .cap-grid { grid-template-columns: 1fr; } }
</style>
