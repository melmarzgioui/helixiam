---
import PageHero from "../PageHero.astro";
import CtaBand from "../CtaBand.astro";
import Icon from "../Icon.astro";
import { docsUrl, t, localeOf, type Locale } from "../../i18n";
import { blog } from "../../pagedata/blog";
const locale: Locale = localeOf(Astro.url.pathname);
const S = blog[locale];
const C = t(locale).cta;
---
<PageHero eyebrow={S.eyebrow} title={S.title} lead={S.lead} icon="code" cta={false} />

<section class="section">
  <div class="container">
    <div class="sec-head reveal"><span class="chip"><Icon name="clock" size={14} />{S.chip}</span><h2 style="margin-top:0.8rem;">{S.whatNext}</h2></div>
    <div class="bl-grid">
      {S.planned.map((p) => (
        <article class="card bl reveal">
          <span class="bl-tag">{p.tag}</span>
          <h3>{p.t}</h3>
          <p>{p.d}</p>
          <span class="bl-soon">{S.soon}</span>
        </article>
      ))}
    </div>
    <div class="bl-cta reveal">
      <p>{S.docsLine}</p>
      <a href={docsUrl(locale)} target="_blank" rel="noopener" class="btn btn-primary">{C.docs}<Icon name="arrow" size={17} /></a>
    </div>
  </div>
</section>

<CtaBand />

<style>
  .sec-head { margin-bottom: 2rem; }
  .bl-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; }
  .bl { display: flex; flex-direction: column; }
  .bl-tag { font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.04em; color: var(--jade); margin-bottom: 0.6rem; }
  .bl p { flex: 1; }
  .bl-soon { font-size: 0.8rem; color: var(--faint); border: 1px dashed var(--line-2); border-radius: 999px; padding: 0.2rem 0.7rem; align-self: flex-start; }
  .bl-cta { text-align: center; margin-top: 2.4rem; }
  .bl-cta p { color: var(--slate); margin-bottom: 1rem; }
  @media (max-width: 720px) { .bl-grid { grid-template-columns: 1fr; } }
</style>
