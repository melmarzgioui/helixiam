---
import Icon from "../Icon.astro";
import { docsUrl, t, localizePath, localeOf, type Locale } from "../../i18n";
import { notfound } from "../../pagedata/notfound";
const locale: Locale = localeOf(Astro.url.pathname);
const L = (href: string) => localizePath(href, locale);
const S = notfound[locale];
const T = t(locale);
---
<section class="nf">
  <div class="container">
    <span class="eyebrow">{S.eyebrow}</span>
    <h1 set:html={S.title}></h1>
    <p class="lead">{S.lead}</p>
    <div class="nf-cta">
      <a href={L("/")} class="btn btn-primary">{T.ui.backHome}<Icon name="arrow" size={17} /></a>
      <a href={L("/product/")} class="btn btn-ghost">{T.cta.explore}</a>
      <a href={docsUrl(locale)} target="_blank" rel="noopener" class="btn btn-ghost">{T.cta.docs}</a>
    </div>
  </div>
</section>
<style>
  .nf { padding-block: clamp(5rem, 14vw, 10rem); text-align: center; }
  .nf .lead { margin-inline: auto; }
  .nf-cta { display: flex; gap: 0.7rem; justify-content: center; flex-wrap: wrap; margin-top: 1.8rem; }
</style>
