---
import LeadForm from "../LeadForm.astro";
import Icon from "../Icon.astro";
import { docsUrl, t, localizePath, localeOf, type Locale } from "../../i18n";
import { demo } from "../../pagedata/demo";
const locale: Locale = localeOf(Astro.url.pathname);
const L = (href: string) => localizePath(href, locale);
const S = demo[locale];
const T = t(locale);
---
<section class="demo-wrap">
  <div class="container demo-grid">
    <div class="demo-copy">
      <span class="eyebrow">{S.eyebrow}</span>
      <h1 set:html={S.title}></h1>
      <p class="lead">{S.lead}</p>
      <ul class="demo-points">
        {S.points.map((p) => (
          <li><span class="dp-ico"><Icon name={p.i} size={18} /></span><div><strong>{p.t}</strong><span>{p.d}</span></div></li>
        ))}
      </ul>
      <div class="demo-alt">
        <p>{S.altHead}</p>
        <div class="demo-alt-links">
          <a href={docsUrl(locale)} target="_blank" rel="noopener" class="btn btn-ghost">{T.cta.docs}</a>
          <a href={L("/why-helixiam/")} class="btn btn-ghost">{T.nav.why}</a>
        </div>
      </div>
    </div>
    <div class="demo-form card">
      <LeadForm kind="demo" />
    </div>
  </div>
</section>

<style>
  .demo-wrap { padding-block: clamp(2.5rem, 6vw, 4.5rem) var(--section-py); position: relative; }
  .demo-grid { display: grid; grid-template-columns: 1fr 1.05fr; gap: 3rem; align-items: start; }
  .demo-copy h1 { font-size: clamp(2.2rem, 4.5vw, 3.2rem); }
  .demo-points { list-style: none; padding: 0; margin: 1.8rem 0; display: grid; gap: 1rem; }
  .demo-points li { display: flex; gap: 0.8rem; }
  .dp-ico { display: inline-flex; width: 38px; height: 38px; flex-shrink: 0; align-items: center; justify-content: center; border-radius: 10px; color: var(--jade); background: rgba(94, 234, 212, 0.08); border: 1px solid rgba(94, 234, 212, 0.2); }
  .demo-points strong { display: block; color: var(--ink); }
  .demo-points span { color: var(--slate); font-size: 0.92rem; }
  .demo-alt { border-top: 1px solid var(--line); padding-top: 1.4rem; }
  .demo-alt p { color: var(--faint); font-size: 0.9rem; margin-bottom: 0.7rem; }
  .demo-alt-links { display: flex; gap: 0.6rem; flex-wrap: wrap; }
  .demo-form { padding: 1.8rem; }
  @media (max-width: 900px) { .demo-grid { grid-template-columns: 1fr; gap: 2rem; } }
</style>
