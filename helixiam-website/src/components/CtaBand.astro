---
import { t, docsUrl, localeOf, localizePath, type Locale } from "../i18n";
interface Props { title?: string; sub?: string; }
const locale: Locale = localeOf(Astro.url.pathname);
const C = t(locale).cta;
const { title = C.bandTitle, sub = C.bandSub } = Astro.props;
---
<section class="section cta-band">
  <div class="container">
    <div class="cta-inner reveal">
      <div class="cta-helix" aria-hidden="true"></div>
      <h2 class="grad-text">{title}</h2>
      <p class="lead">{sub}</p>
      <div class="cta-actions">
        <a href={localizePath("/demo/", locale)} class="btn btn-primary btn-lg">{C.book}</a>
        <a href={docsUrl(locale)} target="_blank" rel="noopener" class="btn btn-ghost btn-lg">{C.docs}</a>
      </div>
      <p class="cta-fine">{C.fine}</p>
    </div>
  </div>
</section>

<style>
  .cta-band { padding-block: clamp(3rem, 6vw, 5rem); }
  .cta-inner { position: relative; overflow: hidden; text-align: center; border: 1px solid var(--line-2); border-radius: var(--r-lg); padding: clamp(2.5rem, 6vw, 4.5rem) 1.5rem; background: radial-gradient(120% 140% at 50% 0%, rgba(52, 224, 176, 0.09), transparent 55%), var(--panel); }
  .cta-inner h2 { max-width: 20ch; margin-inline: auto; }
  .cta-inner .lead { margin-inline: auto; margin-bottom: 1.8rem; }
  .cta-actions { display: flex; gap: 0.8rem; justify-content: center; flex-wrap: wrap; }
  .cta-fine { margin-top: 1.2rem; color: var(--faint); font-size: 0.85rem; }
  .cta-helix { position: absolute; inset: 0; background: radial-gradient(40% 60% at 100% 100%, rgba(143, 139, 255, 0.1), transparent 60%); pointer-events: none; }
</style>
