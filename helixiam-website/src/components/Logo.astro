---
// HelixIAM wordmark — the spark mark + "Helix" / "IAM" lockup.
import { localeOf, localizePath, type Locale } from "../i18n";
interface Props { size?: number; class?: string; }
const { size = 30, class: cls = "" } = Astro.props;
const locale: Locale = localeOf(Astro.url.pathname);
// size (px) scales the wordmark; default 30 → 1.35rem, matching the KubeDNA logotype cap height.
const fontRem = (size / 30 * 1.35).toFixed(3);
---
<a href={localizePath("/", locale)} class={`logo ${cls}`} aria-label="HelixIAM — home" style={`font-size:${fontRem}rem`}>
  <span class="logo-word">Helix<span class="logo-iam">IAM</span><!--
    --><svg class="logo-spark" viewBox="0 0 125 125" fill="none" aria-hidden="true"><path
      d="M 115.0625 65.007812 L 88.875 77.605469 L 72.496094 85.519531 L 65.570312 115.921875 L 65.363281 116.910156 L 61.667969 116.910156 L 61.667969 62.769531 L 9.9375 62.769531 L 10.164062 61.816406 L 10.441406 61.3125 L 11.5 60.808594 L 54.8125 39.949219 L 61.753906 9.546875 L 62.066406 8.160156 L 62.257812 8.089844 L 62.761719 8.332031 L 64.027344 8.941406 L 64.027344 62.769531 L 114.558594 62.769531 L 114.785156 63.636719 Z"
      fill="currentColor"
    /></svg></span>
</a>

<style>
  .logo { display: inline-flex; align-items: center; text-decoration: none; }
  /* KubeDNA-style logotype: Work Sans 800 (self-hosted, KubeDNA's own face), "Helix" fg + "IAM" cyan, spark cap-height at bottom-right. */
  .logo-word { font-family: var(--font); font-weight: 800; font-size: 1em; letter-spacing: -0.02em; color: var(--ink); line-height: 1; white-space: nowrap; }
  /* Canonical lockup: "IAM" = deep KubeDNA cyan (solid, ONE colour on every ground — matches console/docs/login). */
  .logo-iam { color: var(--wordmark-accent); }
  /* the spark = same cyan as "IAM"; cap-height, sits on the baseline (bottom-right) */
  .logo-spark { height: 0.72em; width: 0.72em; margin-left: 0.03em; vertical-align: baseline; color: var(--wordmark-accent); }
</style>
