---
import Base from "./Base.astro";
import { t, localeOf, type Locale } from "../i18n";
interface Props { title: string; updated: string; description?: string; }
const { title, updated, description } = Astro.props;
const locale: Locale = localeOf(Astro.url.pathname);
const U = t(locale).ui;
---
<Base title={title} description={description} translated={true}>
  <section class="section legal">
    <div class="container">
      <span class="eyebrow">{U.legalEyebrow}</span>
      <h1>{title}</h1>
      <p class="legal-updated">{U.legalUpdated} {updated}</p>
      <div class="prose"><slot /></div>
      <div class="legal-note">{U.legalNote}</div>
    </div>
  </section>
</Base>

<style>
  .legal { padding-block: clamp(3rem, 7vw, 5rem) var(--section-py); }
  .legal h1 { max-width: 20ch; }
  .legal-updated { color: var(--faint); font-family: var(--mono); font-size: 0.85rem; }
  .prose { max-width: 760px; margin-top: 2rem; }
  .prose :global(h2) { font-size: 1.4rem; margin-top: 2.2rem; }
  .prose :global(h3) { font-size: 1.1rem; margin-top: 1.6rem; }
  .prose :global(p), .prose :global(li) { color: var(--slate); }
  .prose :global(ul) { padding-left: 1.2rem; display: grid; gap: 0.4rem; }
  .prose :global(strong) { color: var(--ink); }
  .legal-note { max-width: 760px; margin-top: 2.5rem; padding: 1rem 1.2rem; border: 1px dashed var(--line-2); border-radius: var(--r); color: var(--faint); font-size: 0.85rem; }
</style>
